#!/usr/bin/env sh
set -eu
DEST="$HOME/Applications/Snitt.app"
AGENT="$HOME/Library/LaunchAgents/local.snitt.plist"
if [ -f "$AGENT" ]; then
    launchctl bootout "gui/$(id -u)" "$AGENT" 2>/dev/null || true
    rm "$AGENT"
fi
if [ -x "$DEST/Contents/MacOS/snitt" ]; then "$DEST/Contents/MacOS/snitt" --quit; fi
if [ -d "$DEST" ]; then
    /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$DEST/Contents/Info.plist" | /usr/bin/grep -qx local.snitt || exit 1
    rm -rf "$DEST"
fi
echo 'Snitt removed.'

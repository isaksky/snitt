#!/usr/bin/env python3
"""Package an already deployed, signed macOS bundle without changing its signature."""
import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import plistlib
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request


ROOT = Path(__file__).resolve().parent.parent
MACHO = {b"\xfe\xed\xfa\xce", b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xcf",
         b"\xcf\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca"}
PRIVATE_FFMPEG_LIBRARIES = (
    "libavformat.61.dylib", "libavcodec.61.dylib", "libswresample.5.dylib",
    "libswscale.8.dylib", "libavutil.59.dylib",
)
PRIVATE_RUNTIME = ROOT / "build/tools/mac-multimedia-runtime/stage/manifest.json"
SUPPORTED_QT = {"6.11.1", "6.11.2"}
OFFICIAL_QT_SOURCES_6112 = {
    "qtbase": "5b2e00eccaf5a4d8c14134ffa0ea8dfd0a35ae1ffc7f8d87fa4305a1ed23cf22",
    "qtdeclarative": "215b7b70517e380123eabc6b92243f3c47b6f016a91d126057dbe53551c6b430",
    "qtsvg": "d594337feca84c26fb67fe87b85e6a5c12fda404b611d905f9d138210c311876",
    "qtmultimedia": "967b5e02ec6b793cdb360622cd6e703132836af983208d678dae4b50f109cd9f",
    "qtquicktimeline": "250af10500a0c4045dde74e107448a69a44d58af8b7e9a91704a808d5f881d17",
    "qtshadertools": "805046b8b7757665586890b375940047e874ae3ab00adb6d3f2b38fc6b200b1c",
}


def run(*args):
    return subprocess.check_output([str(arg) for arg in args], text=True).strip()


def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            result.update(chunk)
    return result.hexdigest()


def binary_files(directory):
    for path in directory.rglob("*"):
        if path.is_file() and not path.is_symlink():
            with path.open("rb") as handle:
                if handle.read(4) in MACHO:
                    yield path


def private_runtime_manifest(bundle):
    if not PRIVATE_RUNTIME.is_file():
        raise RuntimeError("Private playback runtime manifest is missing; run bin/build")
    manifest = json.loads(PRIVATE_RUNTIME.read_text())
    qt_version = manifest.get("qt_version")
    if (qt_version not in SUPPORTED_QT
            or manifest.get("ffmpeg_version") != "7.1.3"
            or manifest.get("ffmpeg_license") != "LGPL-2.1-or-later"):
        raise RuntimeError("Unexpected private playback runtime or license")
    expected = {"PlugIns/multimedia/libffmpegmediaplugin.dylib"}
    expected.update("Frameworks/" + library for library in PRIVATE_FFMPEG_LIBRARIES)
    if set(manifest.get("artifacts", {})) != expected:
        raise RuntimeError("Private playback runtime manifest has unexpected artifacts")
    contents = bundle / "Contents"
    for relative, sha256 in manifest["artifacts"].items():
        if not (contents / relative).is_file() or digest(contents / relative) != sha256:
            raise RuntimeError(f"Private playback artifact differs from staged build: {relative}")
    sources = contents / "Resources/Sources"
    for name, data in manifest["sources"].items():
        archive = sources / ("ffmpeg-7.1.3.tar.xz" if name == "ffmpeg" else
                             f"qtmultimedia-everywhere-src-{qt_version}.tar.xz")
        if not archive.is_file() or digest(archive) != data["sha256"]:
            raise RuntimeError(f"Private playback source archive missing or changed: {name}")
    for name in ("FFMPEG-CONFIGURE.txt", "QTMULTIMEDIA-BUILD.txt",
                 "qtmultimedia-6.11-sdk26.patch"):
        if not (sources / name).is_file():
            raise RuntimeError(f"Private playback build material missing: {name}")
    return manifest


def verify_bundle(bundle):
    subprocess.run(["codesign", "--verify", "--deep", "--strict", str(bundle)], check=True)
    contents = bundle / "Contents"
    if not (contents / "PlugIns/imageformats/libqsvg.dylib").is_file():
        raise RuntimeError("Bundled SVG image plugin is missing")
    for relative in ("Resources/qml/QtMultimedia/qmldir",
                     "PlugIns/multimedia/libdarwinmediaplugin.dylib",
                     "PlugIns/multimedia/libffmpegmediaplugin.dylib",
                     "MacOS/ffmpeg-media", "MacOS/ffprobe-media",
                     "Frameworks/QtMultimedia.framework/Versions/A/QtMultimedia",
                     "Frameworks/QtQuickTimeline.framework/Versions/A/QtQuickTimeline",
                     "Frameworks/QtQuickTimelineBlendTrees.framework/Versions/A/QtQuickTimelineBlendTrees"):
        if not (contents / relative).is_file():
            raise RuntimeError(f"Bundled multimedia runtime is missing: {relative}")
    for library in PRIVATE_FFMPEG_LIBRARIES:
        if not (contents / "Frameworks" / library).is_file():
            raise RuntimeError(f"Bundled playback codec is missing: {library}")
    qt_version = private_runtime_manifest(bundle)["qt_version"]
    binaries = list(binary_files(bundle))
    dependencies = {}
    for binary in binaries:
        archs = run("lipo", "-archs", binary).split()
        if "arm64" not in archs or not set(archs) <= {"arm64", "x86_64"}:
            raise RuntimeError(f"Expected arm64 or universal binary, found {archs}: {binary}")
        identity_lines = run("otool", "-arch", "arm64", "-D", binary).splitlines()[1:]
        identity = identity_lines[0].strip() if identity_lines else ""
        linked = []
        for line in run("otool", "-arch", "arm64", "-L", binary).splitlines()[1:]:
            name = line.strip().split(" (compatibility version", 1)[0]
            # otool -L includes a dylib's own install-name as its first entry.
            # It is metadata, not a dependency loaded from that original path.
            if name == identity:
                continue
            if "/Qt" in name and ".framework/Versions/A/" in name \
                    and f"current version {qt_version})" not in line:
                raise RuntimeError(f"Mixed Qt framework version in {binary}: {line.strip()}")
            linked.append(name)
            if name.startswith(("/System/Library/", "/usr/lib/")):
                continue
            if name.startswith("@executable_path/"):
                target = contents / "MacOS" / name[len("@executable_path/"):]
            elif name.startswith("@loader_path/"):
                target = binary.parent / name[len("@loader_path/"):]
            elif name.startswith("@rpath/"):
                target = contents / "Frameworks" / name[len("@rpath/"):]
            else:
                raise RuntimeError(f"External runtime dependency in {binary}: {name}")
            if not target.is_file() or not target.resolve().is_relative_to(bundle.resolve()):
                raise RuntimeError(f"Unresolved bundled dependency in {binary}: {name}")
        dependencies[str(binary.relative_to(bundle))] = linked
    return binaries, dependencies


def uuid(path):
    output = run("dwarfdump", "--uuid", path)
    match = re.search(r"UUID: ([0-9A-Fa-f-]+) \(arm64\)", output)
    if not match:
        raise RuntimeError(f"No arm64 Mach-O UUID found: {path}")
    return match.group(1).lower()


def source_packages(bundle, binaries, cellar):
    frameworks = bundle / "Contents" / "Frameworks"
    # These five libraries are built from the separately pinned LGPL source
    # in bin/build-mac-multimedia-runtime, not installed by Homebrew.
    deployed = [p for p in binaries if p.is_relative_to(frameworks)
                and p.name not in PRIVATE_FFMPEG_LIBRARIES]
    names = {p.name for p in deployed}
    candidates = {}
    for path in cellar.rglob("*"):
        if path.name in names and path.is_file():
            with path.open("rb") as handle:
                if handle.read(4) in MACHO:
                    candidates.setdefault(path.name, set()).add(path.resolve())
    packages = {}
    for binary in deployed:
        wanted = uuid(binary)
        matched = None
        for candidate in sorted(candidates.get(binary.name, [])):
            if uuid(candidate) == wanted:
                matched = candidate
                break
        if matched is None:
            raise RuntimeError(f"Cannot match bundled binary to its Homebrew source package: {binary}")
        parts = matched.relative_to(cellar).parts
        package = cellar / parts[0] / parts[1]
        packages.setdefault(package, []).append(str(binary.relative_to(bundle)))
    return packages


def official_qt_binaries(bundle, binaries, sdk):
    frameworks = bundle / "Contents/Frameworks"
    selected = [p for p in binaries if p.is_relative_to(frameworks)
                and p.name not in PRIVATE_FFMPEG_LIBRARIES]
    for binary in selected:
        relative = binary.relative_to(frameworks)
        original = sdk / "lib" / relative
        if not original.is_file() or uuid(binary) != uuid(original):
            raise RuntimeError(f"Bundled Qt binary does not match selected SDK: {binary}")
    return [str(p.relative_to(bundle)) for p in selected]


def notice_file(path):
    name = path.name.lower()
    return name.startswith(("license", "licence", "copying", "copyright", "notice")) \
        or name in {"ftl.txt", "gplv2.txt", "qt_attribution.json"}


def copy_file(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)


def download_source(package, cache):
    recipe = next((package / ".brew").glob("*.rb"))
    contents = recipe.read_text()
    source = re.search(r'^\s*url "([^"\n]+)"', contents, re.MULTILINE)
    checksum = re.search(r'^\s*sha256 "([0-9a-f]{64})"', contents, re.MULTILINE)
    if not source or not checksum or not source.group(1).startswith("https://"):
        raise RuntimeError(f"Cannot find a pinned HTTPS source archive in {recipe}")
    expected = checksum.group(1)
    archive = cache / (expected + ".source")
    if not archive.exists() or digest(archive) != expected:
        print(f"Fetching license source for {package.parent.name} {package.name}", flush=True)
        partial = archive.with_suffix(".download")
        request = urllib.request.Request(source.group(1), headers={"User-Agent": "snitt-release-packager"})
        with urllib.request.urlopen(request, timeout=60) as response, partial.open("wb") as handle:
            shutil.copyfileobj(response, handle)
        if digest(partial) != expected:
            partial.unlink()
            raise RuntimeError(f"Source checksum mismatch: {source.group(1)}")
        partial.replace(archive)
    return archive, source.group(1), expected


def official_source(module, version, cache):
    if version != "6.11.2":
        raise RuntimeError(f"No pinned official Qt source set for {version}")
    expected = OFFICIAL_QT_SOURCES_6112[module]
    name = f"{module}-everywhere-src-{version}.tar.xz"
    url = f"https://download.qt.io/official_releases/qt/6.11/{version}/submodules/{name}"
    archive = cache / name
    if not archive.is_file() or digest(archive) != expected:
        print(f"Fetching Qt source notices for {module} {version}", flush=True)
        partial = cache / (name + ".download")
        request = urllib.request.Request(url, headers={"User-Agent": "snitt-release-packager"})
        with urllib.request.urlopen(request, timeout=60) as response, partial.open("wb") as output:
            shutil.copyfileobj(response, output)
        if digest(partial) != expected:
            partial.unlink()
            raise RuntimeError(f"Official Qt source checksum mismatch: {url}")
        partial.replace(archive)
    return archive, url, expected


def archive_notices(archive, destination):
    # Read selected files directly; never extract untrusted archive paths.
    with tarfile.open(archive) as source:
        members = {member.name: member for member in source if member.isfile()}
        chosen = set()
        for name in members:
            path = PurePosixPath(name)
            if notice_file(path) or "LICENSES" in path.parts:
                chosen.add(name)
            # FreeType and libjpeg also keep complete terms in these files.
            if path.name in {"README", "README.md", "README.ijg"} and len(path.parts) <= 3:
                chosen.add(name)
        # Preserve archive order: seeking backwards repeatedly through an XZ
        # stream would decompress the whole source for each small notice.
        for name in members:
            if name not in chosen or not name.endswith("qt_attribution.json"):
                continue
            # Some upstream attribution strings contain literal line breaks.
            attribution = json.loads(source.extractfile(members[name]).read(), strict=False)
            entries = attribution if isinstance(attribution, list) else [attribution]
            for entry in entries:
                files = entry.get("LicenseFile", "") or []
                if isinstance(files, str):
                    files = [files]
                for license_file in files:
                    relative = os.path.normpath(str(PurePosixPath(name).parent / license_file))
                    if relative in members:
                        chosen.add(relative)
        for name in members:
            if name not in chosen:
                continue
            relative = PurePosixPath(*PurePosixPath(name).parts[1:])
            if relative.is_absolute() or ".." in relative.parts:
                raise RuntimeError(f"Unsafe license source path: {name}")
            target = destination / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            with source.extractfile(members[name]) as origin, target.open("wb") as output:
                shutil.copyfileobj(origin, output)
    if not chosen:
        raise RuntimeError(f"No license material found in source archive {archive}")


def add_notices(payload, packages, cache, dependencies, private_manifest,
                official_sdk=None, official_files=None):
    inventory = []
    licenses = payload / "licenses"
    copy_file(ROOT / "src/icons/LICENSE", licenses / "lucide/LICENSE")
    copy_file(ROOT / "src/OMACUT-LICENSE", licenses / "omacut/LICENSE")
    # These helpers are independent, statically linked LGPL executables built
    # from the pinned source in bin/build-thumbnail-helper-macos. Keep its full
    # corresponding source alongside the release archive.
    ffmpeg_source = ROOT / "build/tools/ffmpeg-thumbnail/ffmpeg-7.1.3.tar.xz"
    ffmpeg_root = ROOT / "build/tools/ffmpeg-thumbnail/ffmpeg-7.1.3"
    ffmpeg_sha256 = "f0bf043299db9e3caacb435a712fc541fbb07df613c4b893e8b77e67baf3adbe"
    if not ffmpeg_source.is_file() or digest(ffmpeg_source) != ffmpeg_sha256:
        raise RuntimeError("Pinned FFmpeg media helper source is missing or invalid")
    ffmpeg_notices = licenses / "ffmpeg-7.1.3"
    copy_file(ffmpeg_source, ffmpeg_notices / ffmpeg_source.name)
    for name in ("LICENSE.md", "COPYING.LGPLv2.1"):
        copy_file(ffmpeg_root / name, ffmpeg_notices / name)
    (ffmpeg_notices / "BUILD.txt").write_text(
        "The bundled ffmpeg-media and ffprobe-media executables are built by "
        "bin/build-thumbnail-helper-macos from the enclosed source archive. "
        "That script records the exact configure flags and disables GPL, "
        "nonfree, hardware decoding, network, and external libraries.\n"
    )
    for package, files in sorted(packages.items()):
        name = package.parent.name
        destination = licenses / f"{name}-{package.name}"
        found = 0
        for path in package.rglob("*"):
            if path.is_file() and notice_file(path) and "man" not in path.parts:
                copy_file(path, destination / "installed" / path.relative_to(package))
                found += 1
        for path in package.glob("share/qt/sbom/*.spdx"):
            copy_file(path, destination / path.name)
        for path in (package / ".brew").glob("*.rb"):
            copy_file(path, destination / path.name)
        receipt = package / "INSTALL_RECEIPT.json"
        if receipt.exists():
            copy_file(receipt, destination / receipt.name)
        record = {"package": name, "version": package.name, "binaries": files}
        # Homebrew omits Qt/glib terms and some licenses referenced by the
        # FreeType/JPEG top-level notice. Use the exact recipe-pinned source.
        if name.startswith("qt") or name in {"glib", "freetype", "jpeg-turbo"} or not found:
            archive, url, sha256 = download_source(package, cache)
            archive_notices(archive, destination / "upstream")
            record.update({"source_url": url, "source_sha256": sha256})
        inventory.append(record)
    if official_sdk is not None:
        version = private_manifest["qt_version"]
        for module in OFFICIAL_QT_SOURCES_6112:
            archive, url, sha256 = official_source(module, version, cache)
            destination = licenses / f"qt-official-{version}" / module
            archive_notices(archive, destination / "upstream")
            for sbom in (official_sdk / "sbom").glob(f"{module}-{version}*.spdx"):
                copy_file(sbom, destination / sbom.name)
            inventory.append({"package": module, "version": version,
                              "binaries": [],
                              "source_url": url, "source_sha256": sha256,
                              "distribution": "official Qt SDK"})
        inventory.append({"package": "qt-official-sdk", "version": version,
                          "binaries": official_files,
                          "distribution": "official Qt SDK",
                          "source_packages": sorted(OFFICIAL_QT_SOURCES_6112)})
    inventory.append({"package": "ffmpeg-media-helpers", "version": "7.1.3",
                      "binaries": ["Contents/MacOS/ffmpeg-media", "Contents/MacOS/ffprobe-media"],
                      "source_url": "https://ffmpeg.org/releases/ffmpeg-7.1.3.tar.xz",
                      "source_sha256": ffmpeg_sha256,
                      "license": "LGPL-2.1-or-later"})
    private_sources = payload / "Snitt.app/Contents/Resources/Sources"
    private_notices = licenses / "private-playback"
    private_notices.mkdir(parents=True)
    copy_file(PRIVATE_RUNTIME, private_notices / "manifest.json")
    for name, archive_name in (("ffmpeg", "ffmpeg-7.1.3.tar.xz"),
                               ("qtmultimedia", f"qtmultimedia-everywhere-src-{private_manifest['qt_version']}.tar.xz")):
        archive_notices(private_sources / archive_name, private_notices / name)
    for name in ("FFMPEG-CONFIGURE.txt", "QTMULTIMEDIA-BUILD.txt",
                 "qtmultimedia-6.11-sdk26.patch"):
        copy_file(private_sources / name, private_notices / name)
    ffmpeg_info = private_manifest["sources"]["ffmpeg"]
    inventory.append({"package": "ffmpeg-private-playback", "version": "7.1.3",
                      "binaries": ["Contents/Frameworks/" + name for name in PRIVATE_FFMPEG_LIBRARIES],
                      "source_url": ffmpeg_info["url"],
                      "source_sha256": ffmpeg_info["sha256"],
                      "license": private_manifest["ffmpeg_license"],
                      "configure": private_manifest["ffmpeg_configure"]})
    qt_info = private_manifest["sources"]["qtmultimedia"]
    inventory.append({"package": "qtmultimedia-private-ffmpeg-plugin", "version": private_manifest["qt_version"],
                      "binaries": ["Contents/PlugIns/multimedia/libffmpegmediaplugin.dylib"],
                      "source_url": qt_info["url"],
                      "source_sha256": qt_info["sha256"],
                      "sdk_patch": "Snitt.app/Contents/Resources/Sources/qtmultimedia-6.11-sdk26.patch"})
    (payload / "DEPENDENCIES.json").write_text(json.dumps({"packages": inventory, "linkage": dependencies}, indent=2) + "\n")
    (payload / "THIRD-PARTY-NOTICES.txt").write_text("""Snitt includes dynamically linked Qt frameworks and may include Homebrew runtime libraries.
Their exact versions, bundled binaries, and link dependencies are listed in
DEPENDENCIES.json. License texts, copyright notices, Qt component attributions,
Qt SBOMs, and source package information are under licenses/.
The Qt source material includes notices for its complete modules, including
components that may not be part of this application. These notices apply to
the named third-party components, not to Snitt itself.

The original frameworks and libraries remain separate and may be replaced by
compatible builds. After replacing a signed library, sign the modified bundle
locally (for example codesign --force --deep --sign - Snitt.app). The original
publisher's private signing key is neither included nor needed to do this.
Modified signing identities may require renewing macOS screen-capture permission.

Qt is copyright The Qt Company Ltd. and other contributors, distributed under
the LGPLv3 option for the included Qt runtime modules. Qt licenses and applicable
third-party terms are included below licenses/qt*/.
Qt source and build recipes: https://code.qt.io/cgit/qt/
Homebrew source recipes and patches, when present: https://github.com/Homebrew/homebrew-core
DEPENDENCIES.json identifies exact upstream source URLs and checksums.
Qt's installed SBOMs identify additional component source locations.

Lucide SVG icons are bundled in Snitt under the Lucide/Feather terms in
licenses/lucide/LICENSE. Source: https://github.com/lucide-icons/lucide

The bundled media helpers are independent LGPL FFmpeg executables.
Their complete corresponding source archive and license are in licenses/ffmpeg-7.1.3/.
They generate filmstrip JPEGs, probe metadata, and copy trimmed streams; no user-installed
FFmpeg package is required on macOS. Source: https://ffmpeg.org/

The recording preview uses a private Qt Multimedia FFmpeg plugin and five
separate LGPL FFmpeg 7.1.3 libraries for software decoding. Their complete
corresponding source archives, build flags, SDK patch, and manifest are in
Snitt.app/Contents/Resources/Sources/ and licenses/private-playback/.
No user-installed FFmpeg package is required for preview playback.

The recording trim filmstrip and time formatter are adapted from omacut under
the MIT license in licenses/omacut/LICENSE. Source: https://github.com/omacom/omacut

Portions of this software are copyright The FreeType Project
(https://freetype.org/). All rights reserved.

macOS recording uses ScreenCaptureKit; the bundled FFmpeg helper is used for
thumbnail decoding, not screen capture or trimmed-video export.
""")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--bundle", type=Path, default=ROOT / "build/package/macos/Snitt.app")
    parser.add_argument("--version", default="0.2.0")
    parser.add_argument("--release-directory", type=Path, default=ROOT / "build/release")
    parser.add_argument("--skip-checksum-manifest", action="store_true",
                        help="Print the digest without changing a shared platform checksum file")
    args = parser.parse_args()
    if sys.platform != "darwin":
        parser.error("macOS is required")
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-.][A-Za-z0-9.]+)?", args.version):
        parser.error("Expected a release version such as 0.1.0")
    bundle = args.bundle.resolve()
    with (bundle / "Contents/Info.plist").open("rb") as handle:
        info = plistlib.load(handle)
    if info.get("CFBundleShortVersionString") != args.version:
        raise RuntimeError("Bundle version does not match the requested release version")
    binaries, dependencies = verify_bundle(bundle)
    private_manifest = private_runtime_manifest(bundle)
    qmake_file = ROOT / "build/.snitt-qmake"
    if not qmake_file.is_file():
        raise RuntimeError("Selected Qt SDK is unknown; run bin/build first")
    qmake = Path(qmake_file.read_text().strip())
    selected_version = run(qmake, "-query", "QT_VERSION")
    if selected_version != private_manifest["qt_version"]:
        raise RuntimeError("Selected Qt SDK differs from private playback runtime")
    sdk = Path(run(qmake, "-query", "QT_INSTALL_PREFIX")).resolve()
    cellar = Path(run("brew", "--cellar")).resolve()
    official_sdk = None
    official_files = None
    # Homebrew qmake can report the shared /opt/homebrew prefix. Its resolved
    # executable still identifies the keg that supplied the selected SDK.
    if sdk.is_relative_to(cellar) or qmake.resolve().is_relative_to(cellar):
        packages = source_packages(bundle, binaries, cellar)
    else:
        official_sdk = sdk
        official_files = official_qt_binaries(bundle, binaries, sdk)
        packages = {}
    release = args.release_directory.resolve()
    release.mkdir(parents=True, exist_ok=True)
    cache = ROOT / "build/package/license-sources"
    cache.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="snitt-macos-release-", dir=release) as temporary:
        payload = Path(temporary) / "payload"
        payload.mkdir()
        subprocess.run(["ditto", str(bundle), str(payload / "Snitt.app")], check=True)
        copy_file(ROOT / "README.md", payload / "README.md")
        copy_file(ROOT / "LICENSE", payload / "LICENSE")
        (payload / "VERSION").write_text(args.version + "\n")
        signature = subprocess.run(["codesign", "-d", "--verbose=2", str(bundle)],
                                   capture_output=True, text=True, check=True).stderr
        signature_description = ("This release uses an ad-hoc code signature."
                                 if "Signature=adhoc" in signature else
                                 "This release is signed with a local development certificate.")
        (payload / "MACOS-INSTALL.txt").write_text("""Snitt for macOS 15 or later, Apple silicon (arm64)

Move Snitt.app into your Applications folder, then open it. Snitt remains in the
menu bar. Use Ctrl+Print Screen (F13 on Mac) to select a region.
Grant Screen & System Audio Recording permission to Snitt when macOS requests it.
For login startup, add Snitt in System Settings > General > Login Items.
Video recording uses macOS ScreenCaptureKit. Thumbnail and preview decoders
are bundled; no separate FFmpeg installation is needed.
Snitt's windows are automatically excluded from the recorded video.

""" + signature_description + """
It is not signed with an Apple Developer ID and is not notarized. macOS Gatekeeper
may require approval in System Settings > Privacy & Security > Open Anyway.
The archive contains no private signing key, certificate export, or keychain.

The application and its bundled libraries are self-contained. Homebrew Qt is
not required to run the app. ScreenCaptureKit is provided by macOS 15 or later.
See README.md for tools and shortcuts and THIRD-PARTY-NOTICES.txt for licenses.
""")
        add_notices(payload, packages, cache, dependencies, private_manifest,
                    official_sdk, official_files)
        verify_bundle(payload / "Snitt.app")
        copy_file(ROOT / "README.md", payload / "README.md")
        archive_name = f"snitt_{args.version}_macos_arm64.zip"
        staged_archive = Path(temporary) / archive_name
        subprocess.run(["ditto", "-c", "-k", "--sequesterRsrc", str(payload), str(staged_archive)], check=True)
        # Verify the actual archived app, including framework symlinks and code signature.
        extracted = Path(temporary) / "verified"
        subprocess.run(["ditto", "-x", "-k", str(staged_archive), str(extracted)], check=True)
        verify_bundle(extracted / "Snitt.app")
        archive = release / archive_name
        staged_archive.replace(archive)
    sha256 = digest(archive)
    if not args.skip_checksum_manifest:
        manifest = release / f"snitt_{args.version}_checksums.txt"
        existing = manifest.read_text().splitlines() if manifest.exists() else []
        # Preserve Windows/other platform entries, replacing only this archive's line.
        lines = [line for line in existing if line.strip() and line.split()[-1].lstrip("*") != archive_name]
        lines.append(f"{sha256}  {archive_name}")
        manifest.write_text("\n".join(sorted(lines, key=lambda line: line.split()[-1])) + "\n")
    print(f"Packaged {archive}\nSHA-256 {sha256}")


if __name__ == "__main__":
    main()

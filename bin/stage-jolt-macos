#!/usr/bin/env python3
"""Stage the real Jolt Snitt app beside the retained C++ comparison bundle."""

import argparse
import os
from pathlib import Path
import plistlib
import runpy
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
COMMON = runpy.run_path(str(ROOT / "bin/package-glimmer-macos"))
RELEASE = runpy.run_path(str(ROOT / "bin/package-macos"))


def run(*command, **kwargs):
    subprocess.run([str(arg) for arg in command], check=True, **kwargs)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--reuse-legacy-stage", action="store_true",
                        help="Reuse a previously verified build/package/macos/Snitt.app")
    args = parser.parse_args()
    if sys.platform != "darwin":
        raise RuntimeError("macOS is required")
    qmake = Path(os.environ.get("SNITT_QMAKE") or
                 (ROOT / "glimmer-qt/build/qmake-path").read_text().strip()).resolve()
    COMMON["require"](qmake, "select a supported Qt SDK")
    env = dict(os.environ, SNITT_QMAKE=str(qmake))
    if args.reuse_legacy_stage:
        RELEASE["verify_bundle"](ROOT / "build/package/macos/Snitt.app")
    else:
        run(ROOT / "bin/stage-macos", env=env)
    run(ROOT / "jolt-snitt/build-app", "--release", env=env)
    if (ROOT / "build/jolt-snitt/qmake-path").read_text().strip() != str(qmake):
        raise RuntimeError("Snitt native bridge was built with a different Qt SDK")

    output = ROOT / "build/package/jolt-macos/Snitt.app"
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="snitt-jolt-stage-", dir=output.parent) as directory:
        work = Path(directory)
        bundle = work / "Snitt.app"
        run("ditto", ROOT / "build/package/macos/Snitt.app", bundle)
        contents = bundle / "Contents"
        (contents / "MacOS/snitt").unlink()
        run("cc", "-arch", "arm64", "-mmacosx-version-min=15.0", "-O2",
            ROOT / "jolt-snitt/native/package_launcher.c", "-o", contents / "MacOS/snitt")
        COMMON["copy"](ROOT / "build/jolt-snitt/snitt-jolt", contents / "MacOS/snitt-jolt")
        for name, source in (("libglimmer_qt.dylib", ROOT / "glimmer-qt/build/libglimmer_qt.dylib"),
                             ("libsnitt_jolt.dylib", ROOT / "build/jolt-snitt/libsnitt_jolt.dylib")):
            COMMON["copy"](source, contents / "Frameworks" / name)
        # The bridge embeds its own resources; its QML inputs still need a scan
        # so macdeployqt carries the matching Qt Quick import plugins.
        scan = work / "qml-scan"
        scan.mkdir()
        for filename in COMMON["QML_FILES"]:
            COMMON["copy"](ROOT / "glimmer-qt/qml" / filename, scan / filename)
        deploy = Path(COMMON["capture"](qmake, "-query", "QT_INSTALL_BINS")) / "macdeployqt"
        COMMON["require"](deploy, "install the matching Qt deployment tool")
        qt_lib = Path(COMMON["capture"](qmake, "-query", "QT_INSTALL_LIBS"))
        for library in ("libglimmer_qt.dylib", "libsnitt_jolt.dylib"):
            run(deploy, bundle, f"-executable={contents / 'Frameworks' / library}",
                f"-qmldir={scan}", f"-libpath={qt_lib}", "-always-overwrite")
        # macdeployqt may replace the private playback plugin. Restore the
        # pinned runtime and source material after all Qt deployment passes.
        run("ditto", ROOT / "build/tools/mac-multimedia-runtime/stage/Contents", contents)
        RELEASE["private_runtime_manifest"](bundle)
        COMMON["repair_signatures"](bundle, COMMON["PRIVATE_FILES"])
        run(ROOT / "bin/sign-macos", bundle)
        RELEASE["verify_bundle"](bundle)
        info = plistlib.loads((contents / "Info.plist").read_bytes())
        if info.get("CFBundleIdentifier") != "local.snitt" or info.get("CFBundleExecutable") != "snitt":
            raise RuntimeError("Jolt staging lost the production bundle identity")
        if output.exists():
            shutil.rmtree(output)
        run("ditto", bundle, output)
    print(f"Staged {output}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(f"Jolt Snitt staging failed: {error}")

#!/usr/bin/env python3
"""Build and stage the production Jolt Snitt bundle for macOS."""

import os
from pathlib import Path
import plistlib
import runpy
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
COMMON = runpy.run_path(str(ROOT / "bin/package-glimmer-macos"))
RELEASE = runpy.run_path(str(ROOT / "bin/package-macos"))


def run(*command, **kwargs):
    subprocess.run([str(arg) for arg in command], check=True, **kwargs)


def main():
    if sys.platform != "darwin":
        raise RuntimeError("macOS is required")
    saved_qmake = ROOT / "glimmer-qt/build/qmake-path"
    selected = (os.environ.get("SNITT_QMAKE") or shutil.which("qmake6") or
                shutil.which("qmake") or
                (saved_qmake.read_text().strip() if saved_qmake.is_file() else None))
    if not selected:
        raise RuntimeError("Qt 6 qmake is required; set SNITT_QMAKE to the supported SDK")
    qmake = Path(selected).resolve()
    COMMON["require"](qmake, "select a supported Qt SDK")
    env = dict(os.environ, SNITT_QMAKE=str(qmake))
    run(ROOT / "bin/build-mac-multimedia-runtime", "--qmake", qmake, "--check-sdk", env=env)
    run(ROOT / "jolt-snitt/build-app", "--release", env=env)
    if (ROOT / "build/jolt-snitt/qmake-path").read_text().strip() != str(qmake):
        raise RuntimeError("Snitt native bridge was built with a different Qt SDK")
    (ROOT / "build/.snitt-qmake").write_text(str(qmake) + "\n")
    run(ROOT / "bin/build-mac-multimedia-runtime", "--qmake", qmake, env=env)

    output = ROOT / "build/package/macos/Snitt.app"
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="snitt-stage-", dir=output.parent) as directory:
        work = Path(directory)
        bundle = work / "Snitt.app"
        contents = bundle / "Contents"
        for name in ("MacOS", "Frameworks", "Resources"):
            (contents / name).mkdir(parents=True)
        COMMON["copy"](ROOT / "platform/macos/Info.plist", contents / "Info.plist")
        run("cc", "-arch", "arm64", "-mmacosx-version-min=15.0", "-O2",
            ROOT / "jolt-snitt/native/package_launcher.c", "-o", contents / "MacOS/snitt")
        COMMON["copy"](ROOT / "build/jolt-snitt/snitt-jolt", contents / "MacOS/snitt-jolt")
        for name, source in (("libglimmer_qt.dylib", ROOT / "glimmer-qt/build/libglimmer_qt.dylib"),
                             ("libsnitt_jolt.dylib", ROOT / "build/jolt-snitt/libsnitt_jolt.dylib")):
            COMMON["copy"](source, contents / "Frameworks" / name)
        # Build the private helper directly into this bundle; no C++ app is built.
        run(ROOT / "bin/build-thumbnail-helper-macos",
            env=dict(env, SNITT_HELPER_DEST=str(contents / "MacOS/ffmpeg-media")))

        scan = work / "qml-scan"
        scan.mkdir()
        for filename in COMMON["QML_FILES"]:
            COMMON["copy"](ROOT / "glimmer-qt/qml" / filename, scan / filename)
        deploy = Path(COMMON["capture"](qmake, "-query", "QT_INSTALL_BINS")) / "macdeployqt"
        COMMON["require"](deploy, "install the matching Qt deployment tool")
        qt_lib = Path(COMMON["capture"](qmake, "-query", "QT_INSTALL_LIBS"))
        libpath = work / "lib"
        libpath.mkdir()
        sources = {source.name: source for source in qt_lib.glob("Qt*.framework")}
        if qt_lib.resolve() == Path("/opt/homebrew/lib"):
            timeline = Path(COMMON["capture"]("brew", "--prefix", "qtquicktimeline")) / "lib"
            sources.update({source.name: source for source in timeline.glob("Qt*.framework")})
        for source in sources.values():
            (libpath / source.name).symlink_to(source, target_is_directory=True)
        for library in ("libglimmer_qt.dylib", "libsnitt_jolt.dylib"):
            run(deploy, bundle, f"-executable={contents / 'Frameworks' / library}",
                f"-qmldir={scan}", f"-libpath={libpath}", "-always-overwrite")
        # Restore the pinned LGPL playback plugin after Qt deployment.
        run("ditto", ROOT / "build/tools/mac-multimedia-runtime/stage/Contents", contents)
        RELEASE["private_runtime_manifest"](bundle)
        COMMON["repair_signatures"](bundle, COMMON["PRIVATE_FILES"])
        run(ROOT / "bin/sign-macos", bundle)
        RELEASE["verify_bundle"](bundle)
        info = plistlib.loads((contents / "Info.plist").read_bytes())
        if info.get("CFBundleIdentifier") != "local.snitt" or info.get("CFBundleExecutable") != "snitt":
            raise RuntimeError("Staging lost the production bundle identity")
        for target in (ROOT / "build/Snitt.app", output):
            if target.exists():
                shutil.rmtree(target)
            run("ditto", bundle, target)
    print(f"Staged {output}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(f"Snitt macOS staging failed: {error}")

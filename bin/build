#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

if [ -n "${SNITT_QMAKE:-}" ]; then
    QMAKE="$SNITT_QMAKE"
elif command -v qmake6 >/dev/null 2>&1; then
    QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
    QMAKE=qmake
elif command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix)/opt/qtbase/bin/qmake" ]; then
    QMAKE="$(brew --prefix)/opt/qtbase/bin/qmake"
elif command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix)/opt/qt/bin/qmake" ]; then
    QMAKE="$(brew --prefix)/opt/qt/bin/qmake"
else
    echo "Qt 6 qmake is required. See README.md for dependencies." >&2
    exit 1
fi
QMAKE="$(command -v "$QMAKE" || true)"
[ -n "$QMAKE" ] && [ -x "$QMAKE" ] || {
    echo "Selected Qt qmake6 is unavailable; set SNITT_QMAKE to a supported SDK's bin/qmake6." >&2
    exit 1
}

if [ "$(uname -s)" = Darwin ]; then
    # Fail before an expensive app/helper build if the selected SDK cannot
    # match a pinned private multimedia plugin source release.
    "$ROOT/bin/build-mac-multimedia-runtime" --qmake "$QMAKE" --check-sdk
else
    case "$("$QMAKE" -query QT_VERSION)" in
        6.*) ;;
        *) echo "Qt 6 is required." >&2; exit 1 ;;
    esac
fi

JOBS=1
if command -v nproc >/dev/null 2>&1; then
    JOBS="$(nproc)"
elif command -v sysctl >/dev/null 2>&1; then
    JOBS="$(sysctl -n hw.ncpu 2>/dev/null || echo 1)"
fi

mkdir -p "$ROOT/build"
printf '%s\n' "$QMAKE" > "$ROOT/build/.snitt-qmake"
if [ "$(uname -s)" = Darwin ]; then
    QT_VERSION="$("$QMAKE" -query QT_VERSION)"
    APP_BUILD="$ROOT/build/mac-app-$QT_VERSION"
else
    APP_BUILD="$ROOT/build"
fi
mkdir -p "$APP_BUILD"
cd "$APP_BUILD"
if [ "$(uname -s)" = Darwin ]; then
    "$QMAKE" "$ROOT/snitt.pro" QMAKE_APPLE_DEVICE_ARCHS=arm64
else
    "$QMAKE" "$ROOT/snitt.pro"
fi
make -j"$JOBS"
# qmake's generated plist target has no input dependencies. Refresh our fixed
# metadata even when an older development bundle already exists.
if [ "$(uname -s)" = Darwin ]; then
    cp "$ROOT/platform/macos/Info.plist" "$APP_BUILD/Snitt.app/Contents/Info.plist"
    "$ROOT/bin/build-mac-multimedia-runtime" --qmake "$QMAKE"
    rm -rf "$ROOT/build/Snitt.app"
    ditto "$APP_BUILD/Snitt.app" "$ROOT/build/Snitt.app"
    "$ROOT/bin/build-thumbnail-helper-macos"
    ditto "$ROOT/build/tools/mac-multimedia-runtime/stage/Contents" "$ROOT/build/Snitt.app/Contents"
fi

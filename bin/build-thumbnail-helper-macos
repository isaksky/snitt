#!/usr/bin/env sh
# Build a small LGPL FFmpeg media helper for thumbnails and lossless trims. It does not link
# Homebrew's GPL-enabled FFmpeg or depend on a user-installed codec package.
set -eu
[ "$(uname -s)" = Darwin ] || { echo 'macOS is required.' >&2; exit 1; }
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
VERSION=7.1.3
SHA256=f0bf043299db9e3caacb435a712fc541fbb07df613c4b893e8b77e67baf3adbe
TOOL_DIR="$ROOT/build/tools/ffmpeg-thumbnail"
ARCHIVE="$TOOL_DIR/ffmpeg-$VERSION.tar.xz"
SOURCE="$TOOL_DIR/ffmpeg-$VERSION"
HELPER="$TOOL_DIR/ffmpeg-media"
STAMP="$TOOL_DIR/.streamcopy-probe-pipe-enabled"
mkdir -p "$TOOL_DIR"
if [ ! -f "$ARCHIVE" ]; then
    curl --fail --location --silent --show-error \
        "https://ffmpeg.org/releases/ffmpeg-$VERSION.tar.xz" -o "$ARCHIVE.download"
    mv "$ARCHIVE.download" "$ARCHIVE"
fi
ACTUAL="$(shasum -a 256 "$ARCHIVE" | cut -d' ' -f1)"
[ "$ACTUAL" = "$SHA256" ] || { echo 'FFmpeg source checksum mismatch.' >&2; exit 1; }
if [ ! -x "$HELPER" ] || [ ! -x "$TOOL_DIR/ffprobe-media" ] || [ ! -f "$STAMP" ]; then
    [ -d "$SOURCE" ] || tar -xf "$ARCHIVE" -C "$TOOL_DIR"
    cd "$SOURCE"
    ./configure \
        --disable-shared --enable-static --disable-everything \
        --disable-autodetect --disable-network --disable-doc --disable-debug \
        --enable-ffprobe --disable-ffplay --disable-hwaccels \
        --disable-videotoolbox --disable-audiotoolbox --enable-small \
        --enable-protocol=file,pipe --enable-demuxer=mov \
        --enable-decoder=h264,hevc --enable-parser=h264,hevc \
        --enable-encoder=mjpeg --enable-muxer=image2,mp4 \
        --enable-filter=scale,format,reverse
    make -j"$(sysctl -n hw.ncpu)" ffmpeg ffprobe
    cp ffmpeg "$HELPER"
    cp ffprobe "$TOOL_DIR/ffprobe-media"
    touch "$STAMP"
fi
DEST="$ROOT/build/xshot.app/Contents/MacOS/ffmpeg-media"
[ -d "$(dirname "$DEST")" ] || { echo 'Build xshot before copying its media helpers.' >&2; exit 1; }
cp "$HELPER" "$DEST"
# macOS verifies nested executable signatures separately from the outer app.
codesign --force --sign - "$DEST" >/dev/null

cp "$TOOL_DIR/ffprobe-media" "$(dirname "$DEST")/ffprobe-media"
codesign --force --sign - "$(dirname "$DEST")/ffprobe-media" >/dev/null

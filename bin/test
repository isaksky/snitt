#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
JOBS="$("$ROOT/bin/build-jobs")"
if [ -n "${SNITT_QMAKE:-}" ]; then
    QMAKE="$SNITT_QMAKE"
elif command -v qmake6 >/dev/null 2>&1; then
    QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
    QMAKE=qmake
else
    echo "Qt 6 qmake is required." >&2
    exit 1
fi
if [ "$(uname -s)" = Darwin ] && [ -n "${SNITT_INTERACTIVE_TESTS:-}" ]; then
    MARKER_DIR="$ROOT/build/tests/recording_marker"
    mkdir -p "$MARKER_DIR"
    cd "$MARKER_DIR"
    "$QMAKE" "$ROOT/tests/recording_marker.pro"
    make -j"$JOBS"
fi
for SUITE in editor_tests imagetool_tests recording_tests; do
    TEST_DIR="$ROOT/build/tests"
    [ "$SUITE" = editor_tests ] || TEST_DIR="$TEST_DIR/$SUITE"
    mkdir -p "$TEST_DIR"
    cd "$TEST_DIR"
    "$QMAKE" "$ROOT/tests/$SUITE.pro"
    make -j"$JOBS"
    TEST_EXIT=0
    QT_QPA_PLATFORM=offscreen "./$SUITE" -o results.txt,txt -o results.xml,junitxml || TEST_EXIT=$?
    cat results.txt
    [ "$TEST_EXIT" -eq 0 ] || exit "$TEST_EXIT"
done

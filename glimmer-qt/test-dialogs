#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"$ROOT/build-native" CONFIG+=property_tests
QMAKE="$(cat "$ROOT/build/qmake-path")"
export QT_PLUGIN_PATH="$("$QMAKE" -query QT_INSTALL_PLUGINS)"
export QML_IMPORT_PATH="$("$QMAKE" -query QT_INSTALL_QML)"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
cd "$ROOT"
# Bound native input/event-loop stalls independently of the GUI deadline.
exec python3 - "${JOLT:-jolt}" "$@" <<'PYTHON'
import subprocess, sys, tempfile, pathlib, os, shutil, plistlib
try:
    with tempfile.TemporaryDirectory(prefix='gqt-dialog-') as directory:
        fixture = pathlib.Path(directory).resolve() / 'space café 日本.png'
        # A real tiny PNG; the chooser must validate an existing image path.
        import base64
        fixture.write_bytes(base64.b64decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jRZkAAAAASUVORK5CYII='))
        os.environ['GQT_DIALOG_FIXTURE'] = str(fixture)
        executable = sys.argv[1]
        if '--native-desktop' in sys.argv:
            # Give the standalone runtime an application identity for desktop AX tools.
            bundle = pathlib.Path(directory) / 'GlimmerDialogs.app' / 'Contents'
            (bundle / 'MacOS').mkdir(parents=True)
            executable = str(bundle / 'MacOS' / 'GlimmerDialogs')
            shutil.copy2(shutil.which(sys.argv[1]), executable)
            (bundle / 'Info.plist').write_bytes(plistlib.dumps({
                'CFBundleExecutable': 'GlimmerDialogs', 'CFBundleName': 'GlimmerDialogs',
                'CFBundleIdentifier': 'org.glimmer.dialog-verification', 'CFBundlePackageType': 'APPL'}))
            print('Desktop fixture app:', bundle.parent, flush=True)
        sys.exit(subprocess.run([executable, '-M:dialogs-test', *sys.argv[2:]], timeout=240 if "--native-desktop" in sys.argv else 60).returncode)
except subprocess.TimeoutExpired:
    sys.exit('Qt dialog tests exceeded 60 seconds')
PYTHON

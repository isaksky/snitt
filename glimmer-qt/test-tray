#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"$ROOT/build-native" CONFIG+=property_tests >/dev/null
QMAKE="$(cat "$ROOT/build/qmake-path")"
export QT_PLUGIN_PATH="$("$QMAKE" -query QT_INSTALL_PLUGINS)"
export QML_IMPORT_PATH="$("$QMAKE" -query QT_INSTALL_QML)"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
cd "$ROOT"
exec python3 - "${JOLT:-jolt}" "$@" <<'PYTHON'
import subprocess, sys
try:
    sys.exit(subprocess.run([sys.argv[1], '-M:tray-test', *sys.argv[2:]], timeout=45).returncode)
except subprocess.TimeoutExpired:
    sys.exit('Qt tray tests exceeded 45 seconds')
PYTHON

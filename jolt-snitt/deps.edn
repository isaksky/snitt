{:paths ["src"]
 :jolt/native [{:name "snitt-jolt"
                :darwin ["../build/jolt-snitt/libsnitt_jolt.dylib"]
                :windows ["../build/jolt-snitt/release/snitt_jolt.dll"
                          "../build/jolt-snitt/snitt_jolt.dll"]
                :linux ["../build/jolt-snitt/libsnitt_jolt.so"]}]
 :deps {snitt/glimmer-qt {:local/root "../glimmer-qt"}}
 :aliases {:run {:main-opts ["-m" "snitt.app"]}
           :test {:extra-paths ["test"] :main-opts ["-m" "snitt.app-test"]}
           :commands {:extra-paths ["test"] :main-opts ["-m" "snitt.commands-test"]}
           :lifecycle {:extra-paths ["test"] :main-opts ["-m" "snitt.lifecycle-test"]}
           :desktop {:extra-paths ["test"] :main-opts ["-m" "snitt.desktop-test"]}
           :annotation {:extra-paths ["test"] :main-opts ["-m" "snitt.annotation-test"]}
           :geometry {:extra-paths ["test"] :main-opts ["-m" "snitt.geometry-test"]}
           :gesture {:extra-paths ["test"] :main-opts ["-m" "snitt.gesture-test"]}
           :arrangement {:extra-paths ["test"] :main-opts ["-m" "snitt.arrangement-test"]}
           :settings {:extra-paths ["test"] :main-opts ["-m" "snitt.settings-test"]}
           :capture {:extra-paths ["test"] :main-opts ["-m" "snitt.capture-test"]}
           :recording {:extra-paths ["test"] :main-opts ["-m" "snitt.recording-test"]}
           :trim {:extra-paths ["test"] :main-opts ["-m" "snitt.trim-test"]}
           :review {:extra-paths ["test"] :main-opts ["-m" "snitt.review-test"]}
           :recording-desktop {:extra-paths ["test"] :main-opts ["-m" "snitt.recording-desktop-test"]}
           :capture-desktop {:extra-paths ["test"] :main-opts ["-m" "snitt.capture-desktop-test"]}}}

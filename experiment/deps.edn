{:paths ["src"]
 :jolt/native [{:name "hello-extensions" :optional true
                :darwin ["libhello_extensions.dylib"
                         "build/extensions/libhello_extensions.dylib"]
                :windows ["build/extensions/release/hello_extensions.dll" "build/extensions/hello_extensions.dll"]
                :linux ["build/extensions/libhello_extensions.so"]}]
 :deps {snitt/glimmer-qt {:local/root "../glimmer-qt"}}
 :aliases {:extensions {:extra-paths ["test"] :main-opts ["-m" "hello.extensions-test"]}
           :images {:extra-paths ["test"] :main-opts ["-m" "hello.images-test"]}
           :snitt {:extra-paths ["test"] :main-opts ["-m" "hello.snitt-test"]}
           :acceptance {:extra-paths ["test"] :main-opts ["-m" "hello.acceptance-test"]}
           :extensions-demo {:main-opts ["-m" "hello.extensions"]}
           :run {:main-opts ["-m" "hello.core"]}
           :smoke {:extra-paths ["test"] :main-opts ["-m" "hello.smoke"]}}}
